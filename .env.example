# Values from Supabase Dashboard > Project Settings > API.
# The publishable key is safe to expose to the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Do not prefix with NEXT_PUBLIC_ and never import it in Client Components.
# It is not required by the current read-only integration.
SUPABASE_SERVICE_ROLE_KEY=
